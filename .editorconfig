root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.java]
indent_style = tab
# Generated sources carry "// @formatter:off": reformatting them would diverge from the generator.
ij_formatter_tags_enabled = true
ij_formatter_off_tag = @formatter:off
ij_formatter_on_tag = @formatter:on

[tools/*.py]
indent_style = space
indent_size = 4

[*.{xml,yaml,yml,json,md}]
indent_style = space
indent_size = 4
